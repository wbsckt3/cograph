<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Usuarios Conectados - Cytoscape.js</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; font-family: sans-serif; }
    #cy { width: 100vw; height: 100vh; display: block; }
    #login-info {
      position: absolute; top: 10px; left: 10px; right: 10px;
      background: rgba(255,255,255,0.95); padding: 8px; border-radius: 6px; z-index: 10;
    }
    #login-info h3 { margin: 4px 0; font-size: 14px; }
    #login-info input, #login-info button {
      width: 100%; font-size: 14px; margin: 4px 0; padding: 6px; box-sizing: border-box;
    }
  </style>
  <!-- Cytoscape.js -->
  <script src="https://unpkg.com/cytoscape@3.24.0/dist/cytoscape.min.js"></script>
  <!-- Google Sign-In -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <!-- Socket.IO client -->
  <script src="https://cdn.socket.io/4.6.1/socket.io.min.js"></script>
</head>
<body>  <div id="login-info">
    <div id="g_id_onload"
      data-client_id="980822676255-vntch0t28qbesul2bp5oc1galtoi8a97.apps.googleusercontent.com"
      data-callback="handleCredentialResponse"
      data-ux_mode="popup"
      data-auto_select="true">
    </div>
    <div class="g_id_signin"
      data-type="standard"
      data-shape="rectangular"
      data-theme="outline"
      data-text="signin_with"
      data-size="large"
      data-logo_alignment="left">
    </div>
    <h3 id="user-info">No autenticado</h3>
    <input type="text" id="estado-input" placeholder="Estado (ej: Disponible)">
    <input type="text" id="url-input" placeholder="Enlace (ej: https://t.me/usuario)">
    <button id="update-btn">Actualizar Nodo</button>
  </div>  <div id="cy"></div>  <script>
    // Inicializar Cytoscape
    const cy = cytoscape({
      container: document.getElementById('cy'),
      elements: [],
      style: [
        { selector: 'node', style: { 'content': 'data(label)', 'text-wrap': 'wrap', 'text-valign': 'center', 'text-halign': 'center', 'background-color': '#0077cc', 'color': '#fff', 'font-size': '12px', 'width': 'label', 'height': 'label', 'padding': '10px' } },
        { selector: 'edge', style: { 'width': 3, 'line-color': '#ccc', 'curve-style': 'bezier' } }
      ],
      layout: { name: 'grid', rows: 1 }
    });

    // Conectar Socket.IO
    const socket = io('http://localhost:3000'); // Reemplazar con tu servidor

    // Variables de sesión
    let currentUser = null;

    // Función para crear o actualizar nodo
    function upsertUserNode(user) {
      const id = user.email;
      if (cy.getElementById(id).empty()) {
        cy.add({ group: 'nodes', data: { id, label: `${user.name}\n${user.estado}\n${user.url}` } });
      } else {
        const n = cy.getElementById(id);
        n.data('label', `${user.name}\n${user.estado}\n${user.url}`);
      }
      cy.layout({ name: 'grid', rows: cy.nodes().length }).run();
    }

    // Evento: nuevo usuario existente al conectarse
    socket.on('usuario-conectado', (user) => {
      upsertUserNode(user);
    });

    // Botón actualizar nodo
    document.getElementById('update-btn').addEventListener('click', () => {
      if (!currentUser) return;
      const estado = document.getElementById('estado-input').value;
      const url = document.getElementById('url-input').value;
      const user = { ...currentUser, estado, url };
      upsertUserNode(user);
      socket.emit('nuevo-usuario', user);
    });

    // Google Sign-In
    function decodeJwtResponse(token) {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(c =>
        '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
      ).join(''));
      return JSON.parse(jsonPayload);
    }
    
    function handleCredentialResponse(response) {
      const payload = decodeJwtResponse(response.credential);
      currentUser = { name: payload.name, email: payload.email, estado: '', url: '' };
      localStorage.setItem('usuario', JSON.stringify(currentUser));
      document.getElementById('user-info').textContent = `Usuario: ${payload.email}`;
      document.querySelector('.g_id_signin').style.display = 'none';
      document.getElementById('g_id_onload').style.display = 'none';
      upsertUserNode(currentUser);
      socket.emit('nuevo-usuario', currentUser);
    }

    // Restaurar sesión si existe
    window.addEventListener('DOMContentLoaded', () => {
      const saved = localStorage.getItem('usuario');
      if (saved) {
        currentUser = JSON.parse(saved);
        document.getElementById('user-info').textContent = `Usuario: ${currentUser.email}`;
        document.querySelector('.g_id_signin').style.display = 'none';
        document.getElementById('g_id_onload').style.display = 'none';
        upsertUserNode(currentUser);
        socket.emit('nuevo-usuario', currentUser);
      }
    });
  </script></body>
</html>
